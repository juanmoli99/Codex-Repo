# Copy to .env only for local development. Never commit the resulting file.
APP_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
LOG_DIRECTORY=./logs
OPERATOR_TIMEZONE=America/Argentina/Buenos_Aires
MARKET_TIMEZONE=America/New_York
BASE_CURRENCY=USD
MAX_CLOCK_SKEW_MS=1000

DATABASE_URL=postgresql://aegis:aegis_local_only@127.0.0.1:5432/aegis?schema=public

# PAPER is the only safe default.
TRADING_MODE=PAPER
BROKER_CONNECTIVITY_ENABLED=false
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=
ENABLE_LIVE_TRADING=false
LIVE_ACTIVATION_PHRASE=
SECRETS_PROVIDER=env
RELEASE_SHA=0000000
DEPLOYMENT_ID=local-development

# Runtime fail-closed
MARKET_DATA_TIMEFRAME=1Min
MARKET_DATA_MAX_AGE_MS=90000
MARKET_DATA_WARMUP_BARS=60
SCANNER_MAX_SYMBOLS=200
SCANNER_TIMEOUT_MS=120000
SCHEDULER_INTERVAL_MS=60000
RECONCILIATION_INTERVAL_MS=60000
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_DEAD_AFTER_MS=20000

# Generate with: pnpm --filter @aegis/backend operator:hash -- "a-long-random-password"
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD_HASH=
SESSION_SIGNING_SECRET=
CSRF_SIGNING_SECRET=
SESSION_TTL_MINUTES=30
TRUSTED_ORIGINS=http://127.0.0.1:5173
MAX_PAYLOAD_BYTES=1048576
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Optional trusted delivery channels. Empty means disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_URL=
ALERT_EMAIL_TO=
OPERATOR_TOTP_SECRET=

# In containers, prefer NAME_FILE=/run/secrets/... for DATABASE_URL, Alpaca credentials,
# authentication secrets, Telegram credentials and OPERATOR_TOTP_SECRET. Do not set both forms.
