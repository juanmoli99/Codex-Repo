# Non-secret deployment coordinates. Use two separate copies/hosts/projects for PAPER and LIVE.
COMPOSE_PROJECT_NAME=aegis-paper
TRADING_MODE=PAPER
BROKER_CONNECTIVITY_ENABLED=true
ENABLE_LIVE_TRADING=false
LIVE_ACTIVATION_PHRASE=
DEPLOYMENT_ID=paper-2026-08-19
RELEASE_SHA=replace-with-the-exact-40-character-git-sha
AEGIS_BACKEND_IMAGE=ghcr.io/owner/repository/aegis-backend@sha256:replace-with-digest
AEGIS_FRONTEND_IMAGE=ghcr.io/owner/repository/aegis-frontend@sha256:replace-with-digest
AEGIS_WATCHDOG_IMAGE=ghcr.io/owner/repository/aegis-watchdog@sha256:replace-with-digest
AEGIS_BACKUP_IMAGE=ghcr.io/owner/repository/aegis-backup@sha256:replace-with-digest

POSTGRES_DB=aegis
POSTGRES_USER=aegis
HTTPS_PORT=8443
TRUSTED_ORIGINS=https://127.0.0.1:8443
OPERATOR_USERNAME=operator
OPERATOR_TIMEZONE=America/Argentina/Buenos_Aires
ALPACA_DATA_FEED=iex
LOG_LEVEL=info

# Names of pre-created Docker secrets. Their values never belong in this file.
POSTGRES_PASSWORD_SECRET=aegis-paper-postgres-password
DATABASE_URL_SECRET=aegis-paper-database-url
ALPACA_API_KEY_SECRET=aegis-paper-alpaca-key
ALPACA_API_SECRET_SECRET=aegis-paper-alpaca-secret
OPERATOR_PASSWORD_HASH_SECRET=aegis-paper-operator-password-hash
SESSION_SIGNING_SECRET_NAME=aegis-paper-session-signing-secret
CSRF_SIGNING_SECRET_NAME=aegis-paper-csrf-signing-secret
OPERATOR_TOTP_SECRET_NAME=aegis-paper-operator-totp-secret
TELEGRAM_BOT_TOKEN_SECRET=aegis-paper-telegram-token
TELEGRAM_CHAT_ID_SECRET=aegis-paper-telegram-chat-id
TLS_CERTIFICATE_SECRET=aegis-paper-tls-certificate
TLS_PRIVATE_KEY_SECRET=aegis-paper-tls-private-key

# Backup profile (off-host object storage).
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_RECORD_RETENTION_DAYS=2555
BACKUP_PREFIX=aegis-paper
BACKUP_S3_URI=s3://private-offsite-bucket/aegis-paper
BACKUP_SSE=AES256
BACKUP_KMS_KEY_ID=
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID_SECRET=aegis-paper-aws-access-key-id
AWS_SECRET_ACCESS_KEY_SECRET=aegis-paper-aws-secret-access-key
AWS_ENDPOINT_URL=
