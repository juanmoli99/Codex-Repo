{
  "name": "@aegis/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --import tsx src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:format": "node --env-file-if-exists=../.env ./node_modules/prisma/build/index.js format",
    "db:generate": "node --env-file-if-exists=../.env ./node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=../.env ./node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file-if-exists=../.env ./node_modules/prisma/build/index.js migrate deploy",
    "db:validate": "node --env-file-if-exists=../.env ./node_modules/prisma/build/index.js validate",
    "operator:hash": "node --import tsx src/scripts/hash-password.ts"
  },
  "dependencies": {
    "@aegis/shared": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "11.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "decimal.js": "10.6.0",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "ws": "8.22.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "4.1.11",
    "pino-pretty": "13.1.3",
    "prisma": "7.9.1",
    "vitest": "4.1.11"
  }
}
