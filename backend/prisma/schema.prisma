  assessment            LiveReadinessRecord @relation(fields: [assessmentId], references: [id], onDelete: Restrict)

  @@index([assessmentId, outcome, createdAt])
  @@index([challengeExpiresAt, consumedAt])
  @@map("live_activations")
}
