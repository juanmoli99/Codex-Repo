generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum OperationalState {
  READY
  DEGRADED
  BLOCKED
  EMERGENCY
}

enum TradingMode {
  PAPER
  LIVE
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum SessionState {
  ACTIVE
  REVOKED
  EXPIRED
}

enum BackupState {
  STARTED
  COMPLETED
  VERIFIED
  FAILED
  EXPIRED
}

enum MarketDataHealth {
  HEALTHY
  STALE
  UNAVAILABLE
  INCONSISTENT
}

enum CorporateActionState {
  PENDING
  EFFECTIVE
  RECONCILING
  RECONCILED
  AMBIGUOUS
}

enum EventTiming {
  PRE_MARKET
  POST_MARKET
  DURING_MARKET
  UNKNOWN
}

enum StrategyLifecycle {
  ACTIVE
  RETIRING
  DISABLED
}

enum StrategySignalType {
  BUY
  SELL
  HOLD
  EXIT
}

enum StrategySignalState {
  ACTIVE
  EXPIRED
  INVALIDATED
  CONSUMED
}

enum ScannerExecutionStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum RiskDecisionOutcome {
  APPROVED
  REJECTED
}

enum SafetyMode {
  NORMAL
  ONLY_CLOSE
  KILL_SWITCH
  EMERGENCY_STOP
}

enum TradeIntentState {
  CREATED
  VALIDATING
  APPROVED
  EXECUTING
  SUBMITTED
  REJECTED
  UNKNOWN
  COMPLETED
}

enum OrderLifecycleState {
  CREATED
  VALIDATING
  APPROVED
  SUBMITTING
  SUBMITTED
  ACCEPTED
  PARTIALLY_FILLED
  FILLED
  CANCEL_PENDING
  CANCELED
  REJECTED
  EXPIRED
  REPLACED
  UNKNOWN
}

enum SchedulerRunState {
  STOPPED
  RUNNING
  PAUSED
  BLOCKED
}

enum ReconciliationRunState {
  RUNNING
  MATCHED
  CORRECTED
  BLOCKED
  FAILED
}

enum AlertState {
  PENDING
  SENT
  FAILED
  ACKNOWLEDGED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
  EMERGENCY
}

enum LiveReadinessState {
  NOT_READY
  READY_FOR_ACTIVATION
  ACTIVE
  REVOKED
}

model SystemStateRecord {
  id           String           @id @default("singleton")
  state        OperationalState @default(BLOCKED)
  tradingMode  TradingMode      @default(PAPER)
  reasonCode   String
  reasonDetail String?
  changedBy    String
  version      Int              @default(0)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6)

  @@map("system_state")
}

model DistributedLock {
  name         String   @id
  ownerId      String
  fencingToken BigInt   @default(autoincrement())
  acquiredAt   DateTime @default(now()) @db.Timestamptz(6)
  heartbeatAt  DateTime @default(now()) @db.Timestamptz(6)
  expiresAt    DateTime @db.Timestamptz(6)
  metadata     Json?

  @@index([expiresAt])
  @@map("distributed_locks")
}

model Operator {
  id                  String       @id @default(uuid()) @db.Uuid
  username            String       @unique @db.VarChar(128)
  passwordHash        String       @db.VarChar(512)
  active              Boolean      @default(true)
  failedLoginCount    Int          @default(0)
  lockedUntil         DateTime?    @db.Timestamptz(6)
  passwordChangedAt   DateTime     @default(now()) @db.Timestamptz(6)
  lastSuccessfulLogin DateTime?    @db.Timestamptz(6)
  version             Int          @default(0)
  createdAt           DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(6)
  sessions            Session[]
  auditEvents         AuditEvent[]

  @@map("operators")
}

model Session {
  id            String       @id @default(uuid()) @db.Uuid
  operatorId    String       @db.Uuid
  tokenHash     String       @unique @db.Char(64)
  csrfTokenHash String       @db.Char(64)
  state         SessionState @default(ACTIVE)
  ipAddress     String?      @db.VarChar(64)
  userAgent     String?      @db.VarChar(512)
  expiresAt     DateTime     @db.Timestamptz(6)
  lastSeenAt    DateTime     @default(now()) @db.Timestamptz(6)
  revokedAt     DateTime?    @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(6)
  operator      Operator     @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId, state])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditEvent {
  id            String        @id @default(uuid()) @db.Uuid
  operatorId    String?       @db.Uuid
  severity      AuditSeverity
  action        String        @db.VarChar(128)
  resourceType  String        @db.VarChar(128)
  resourceId    String?       @db.VarChar(256)
  correlationId String        @db.Uuid
  ipAddress     String?       @db.VarChar(64)
  userAgent     String?       @db.VarChar(512)
  outcome       String        @db.VarChar(64)
  metadata      Json?
  occurredAt    DateTime      @default(now()) @db.Timestamptz(6)
  operator      Operator?     @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([correlationId])
  @@index([resourceType, resourceId])
  @@map("audit_events")
}

model ConfigurationSnapshot {
  id            String      @id @default(uuid()) @db.Uuid
  version       Int
  environment   String      @db.VarChar(32)
  tradingMode   TradingMode
  checksum      String      @db.Char(64)
  redactedValue Json
  deployedAt    DateTime    @default(now()) @db.Timestamptz(6)

  @@unique([environment, version])
  @@index([checksum])
  @@map("configuration_snapshots")
}

model PortfolioSnapshot {
  id             String                   @id @default(uuid()) @db.Uuid
  equity         Decimal                  @db.Decimal(20, 8)
  cash           Decimal                  @db.Decimal(20, 8)
  buyingPower    Decimal                  @db.Decimal(20, 8)
  portfolioValue Decimal                  @db.Decimal(20, 8)
  accountStatus  String                   @default("UNKNOWN") @db.VarChar(64)
  daytradeCount  Int                      @default(0)
  currency       String                   @db.Char(3)
  brokerTime     DateTime                 @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(6)
  positions      PositionSnapshotRecord[]

  @@index([createdAt])
  @@map("portfolio_snapshots")
}

model PositionSnapshotRecord {
  id                   String            @id @default(uuid()) @db.Uuid
  portfolioSnapshotId  String            @db.Uuid
  symbol               String            @db.VarChar(32)
  side                 String            @db.VarChar(16)
  quantity             Decimal           @db.Decimal(30, 12)
  averageEntryPrice    Decimal           @db.Decimal(20, 8)
  marketPrice          Decimal           @db.Decimal(20, 8)
  marketValue          Decimal           @db.Decimal(20, 8)
  costBasis            Decimal           @db.Decimal(20, 8)
  unrealizedPnl        Decimal           @db.Decimal(20, 8)
  realizedPnl          Decimal           @db.Decimal(20, 8)
  pendingOrderExposure Decimal           @db.Decimal(20, 8)
  strategyId           String?           @db.VarChar(128)
  strategyVersion      String?           @db.VarChar(64)
  unexpected           Boolean           @default(false)
  orphaned             Boolean           @default(false)
  createdAt            DateTime          @default(now()) @db.Timestamptz(6)
  portfolioSnapshot    PortfolioSnapshot @relation(fields: [portfolioSnapshotId], references: [id], onDelete: Cascade)

  @@index([portfolioSnapshotId, symbol])
  @@map("position_snapshots")
}

model BackupRecord {
  id             String      @id @default(uuid()) @db.Uuid
  state          BackupState
  objectKey      String      @unique @db.VarChar(1024)
  checksum       String?     @db.Char(64)
  sizeBytes      BigInt?
  sourceHost     String      @db.VarChar(255)
  offsite        Boolean     @default(false)
  retentionUntil DateTime    @db.Timestamptz(6)
  startedAt      DateTime    @default(now()) @db.Timestamptz(6)
  completedAt    DateTime?   @db.Timestamptz(6)
  verifiedAt     DateTime?   @db.Timestamptz(6)
  error          String?
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)

  @@index([state, retentionUntil])
  @@map("backup_records")
}

model BrokerRequestRecord {
  id              String   @id @default(uuid()) @db.Uuid
  correlationId   String   @db.Uuid
  brokerRequestId String?  @db.VarChar(256)
  service         String   @db.VarChar(32)
  method          String   @db.VarChar(16)
  path            String   @db.VarChar(512)
  statusCode      Int?
  latencyMs       Int
  retryAttempt    Int      @default(1)
  outcome         String   @db.VarChar(64)
  occurredAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([correlationId])
  @@index([brokerRequestId])
  @@index([occurredAt])
  @@map("broker_request_records")
}

model RegulatoryRuleVersion {
  id             String    @id @db.VarChar(128)
  regime         String    @db.VarChar(64)
  effectiveFrom  DateTime  @db.Date
  effectiveUntil DateTime? @db.Date
  rules          Json
  source         String    @db.VarChar(512)
  checksum       String    @unique @db.Char(64)
  active         Boolean   @default(false)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([effectiveFrom, effectiveUntil])
  @@map("regulatory_rule_versions")
}

model MarketDataStateRecord {
  symbol             String           @id @db.VarChar(32)
  health             MarketDataHealth @default(UNAVAILABLE)
  lastValidTimestamp DateTime?        @db.Timestamptz(6)
  lastBarAt          DateTime?        @db.Timestamptz(6)
  lastQuoteAt        DateTime?        @db.Timestamptz(6)
  lastTradeAt        DateTime?        @db.Timestamptz(6)
  warmupBarsObserved Int              @default(0)
  warmupCompletedAt  DateTime?        @db.Timestamptz(6)
  recoveryEvidence   Json?
  reason             String?
  version            Int              @default(0)
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6)

  @@index([health])
  @@map("market_data_states")
}

model MarketDataAnomalyRecord {
  id            String    @id @default(uuid()) @db.Uuid
  symbol        String    @db.VarChar(32)
  code          String    @db.VarChar(128)
  severity      String    @db.VarChar(32)
  detail        String
  dataTime      DateTime? @db.Timestamptz(6)
  detectedAt    DateTime  @default(now()) @db.Timestamptz(6)
  correlationId String?   @db.Uuid

  @@index([symbol, detectedAt])
  @@index([code, severity])
  @@map("market_data_anomalies")
}

model AssetRecord {
  id              String              @id @db.Uuid
  symbol          String              @unique @db.VarChar(32)
  name            String
  assetClass      String              @db.VarChar(64)
  exchange        String              @db.VarChar(64)
  status          String              @db.VarChar(64)
  tradable        Boolean
  fractionable    Boolean
  shortable       Boolean
  marginable      Boolean
  attributes      Json
  brokerUpdatedAt DateTime            @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(6)
  watchlist       WatchlistRecord?
  blocks          SymbolBlockRecord[]

  @@index([status, tradable])
  @@map("assets")
}

model WatchlistRecord {
  id        String      @id @default(uuid()) @db.Uuid
  assetId   String      @unique @db.Uuid
  active    Boolean     @default(true)
  metadata  Json?
  createdAt DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @db.Timestamptz(6)
  asset     AssetRecord @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([active])
  @@map("watchlist")
}

model SymbolBlockRecord {
  id         String      @id @default(uuid()) @db.Uuid
  assetId    String      @db.Uuid
  reason     String      @db.VarChar(256)
  source     String      @db.VarChar(128)
  blockedAt  DateTime    @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime?   @db.Timestamptz(6)
  releasedAt DateTime?   @db.Timestamptz(6)
  asset      AssetRecord @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, expiresAt, releasedAt])
  @@map("symbol_blocks")
}

model HaltEventRecord {
  id            String    @id @default(uuid()) @db.Uuid
  symbol        String    @db.VarChar(32)
  statusCode    String    @db.VarChar(32)
  statusMessage String
  reasonCode    String?   @db.VarChar(32)
  reasonMessage String?
  eventTime     DateTime  @db.Timestamptz(6)
  receivedAt    DateTime  @default(now()) @db.Timestamptz(6)
  resumedAt     DateTime? @db.Timestamptz(6)
  luldUpper     Decimal?  @db.Decimal(20, 8)
  luldLower     Decimal?  @db.Decimal(20, 8)
  raw           Json

  @@unique([symbol, statusCode, eventTime])
  @@index([symbol, eventTime])
  @@map("halt_events")
}

model CorporateActionRecord {
  id            String                            @id @db.VarChar(128)
  type          String                            @db.VarChar(64)
  state         CorporateActionState
  symbol        String                            @db.VarChar(32)
  newSymbol     String?                           @db.VarChar(32)
  effectiveAt   DateTime                          @db.Timestamptz(6)
  quantityRatio Decimal?                          @db.Decimal(30, 12)
  cashAmount    Decimal?                          @db.Decimal(20, 8)
  raw           Json
  createdAt     DateTime                          @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime                          @updatedAt @db.Timestamptz(6)
  adjustments   CorporateActionAdjustmentRecord[]

  @@index([symbol, effectiveAt])
  @@index([state])
  @@map("corporate_actions")
}

model CorporateActionAdjustmentRecord {
  id         String                @id @default(uuid()) @db.Uuid
  actionId   String                @db.VarChar(128)
  entityType String                @db.VarChar(64)
  entityId   String                @db.VarChar(256)
  operation  String                @db.VarChar(128)
  before     Json
  after      Json
  createdAt  DateTime              @default(now()) @db.Timestamptz(6)
  action     CorporateActionRecord @relation(fields: [actionId], references: [id], onDelete: Restrict)

  @@unique([actionId, entityType, entityId, operation])
  @@index([entityType, entityId])
  @@map("corporate_action_adjustments")
}

model MarketEventRecord {
  id            String      @id @db.VarChar(128)
  symbol        String?     @db.VarChar(32)
  type          String      @db.VarChar(64)
  scheduledAt   DateTime    @db.Timestamptz(6)
  timing        EventTiming
  source        String      @db.VarChar(128)
  sourceVersion String      @db.VarChar(128)
  raw           Json?
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(6)

  @@index([symbol, type, scheduledAt])
  @@map("market_events")
}

model EventPolicyApplicationRecord {
  id                     String   @id @default(uuid()) @db.Uuid
  policyId               String   @db.VarChar(128)
  strategyId             String   @db.VarChar(128)
  symbol                 String   @db.VarChar(32)
  eventId                String?  @db.VarChar(128)
  evaluatedAt            DateTime @db.Timestamptz(6)
  timeToEventMs          BigInt?
  entryAllowed           Boolean
  positionSizeMultiplier Decimal  @db.Decimal(8, 6)
  overnightAllowed       Boolean
  reasons                Json
  configurationSnapshot  Json
  createdAt              DateTime @default(now()) @db.Timestamptz(6)

  @@index([strategyId, symbol, evaluatedAt])
  @@map("event_policy_applications")
}

model StrategyVersionRecord {
  id                   String            @id @default(uuid()) @db.Uuid
  strategyId           String            @db.VarChar(128)
  version              String            @db.VarChar(64)
  configurationVersion String            @db.VarChar(128)
  deploymentId         String            @db.VarChar(128)
  lifecycle            StrategyLifecycle
  timeframe            String            @default("1Min") @db.VarChar(16)
  sessionPolicy        String            @default("REGULAR_ONLY") @db.VarChar(32)
  overnightPolicy      String            @default("FLAT_AT_CLOSE") @db.VarChar(32)
  eventRiskPolicy      String            @default("BLOCK_ENTRIES") @db.VarChar(32)
  commitSha            String?           @db.VarChar(64)
  buildChecksum        String?           @db.Char(64)
  parameters           Json
  requiredIndicators   Json
  assetOverrides       Json?
  cooldownMs           Int
  maximumSignalsPerDay Int
  maximumTradesPerDay  Int
  activatedAt          DateTime?         @db.Timestamptz(6)
  retiredAt            DateTime?         @db.Timestamptz(6)
  disabledAt           DateTime?         @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @db.Timestamptz(6)

  @@unique([strategyId, version])
  @@index([strategyId, lifecycle])
  @@index([deploymentId])
  @@map("strategy_versions")
}

model StrategySignalRecord {
  id                    String              @id @db.Uuid
  symbol                String              @db.VarChar(32)
  strategyId            String              @db.VarChar(128)
  strategyVersion       String              @db.VarChar(64)
  configurationVersion  String              @db.VarChar(128)
  deploymentId          String              @db.VarChar(128)
  type                  StrategySignalType
  state                 StrategySignalState @default(ACTIVE)
  reason                String
  confidence            Decimal?            @db.Decimal(8, 6)
  expectedEdgeBps       Decimal?            @db.Decimal(12, 4)
  parametersSnapshot    Json
  configurationSnapshot Json
  deduplicationKey      String              @unique @db.Char(64)
  signaledAt            DateTime            @db.Timestamptz(6)
  expiresAt             DateTime            @db.Timestamptz(6)
  invalidatedAt         DateTime?           @db.Timestamptz(6)
  invalidationReason    String?
  createdAt             DateTime            @default(now()) @db.Timestamptz(6)

  @@index([symbol, signaledAt])
  @@index([strategyId, strategyVersion, signaledAt])
  @@index([state, expiresAt])
  @@map("strategy_signals")
}

model StrategyPositionBindingRecord {
  id               String    @id @default(uuid()) @db.Uuid
  symbol           String    @db.VarChar(32)
  strategyId       String    @db.VarChar(128)
  strategyVersion  String    @db.VarChar(64)
  openedBySignalId String    @db.Uuid
  active           Boolean   @default(true)
  boundAt          DateTime  @default(now()) @db.Timestamptz(6)
  releasedAt       DateTime? @db.Timestamptz(6)

  @@index([symbol, active])
  @@index([strategyId, strategyVersion, active])
  @@map("strategy_position_bindings")
}

model StrategyVersionMigrationRecord {
  id          String   @id @db.Uuid
  symbol      String   @db.VarChar(32)
  strategyId  String   @db.VarChar(128)
  fromVersion String   @db.VarChar(64)
  toVersion   String   @db.VarChar(64)
  reason      String
  approvedBy  String   @db.VarChar(128)
  migratedAt  DateTime @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([strategyId, symbol, migratedAt])
  @@map("strategy_version_migrations")
}

model ScannerExecutionRecord {
  id               String                 @id @db.Uuid
  idempotencyKey   String                 @unique @db.VarChar(256)
  trigger          String                 @db.VarChar(32)
  status           ScannerExecutionStatus
  symbolsProcessed Int                    @default(0)
  symbolsFailed    Int                    @default(0)
  startedAt        DateTime               @db.Timestamptz(6)
  finishedAt       DateTime?              @db.Timestamptz(6)
  durationMs       Int?
  createdAt        DateTime               @default(now()) @db.Timestamptz(6)
  results          ScannerResultRecord[]

  @@index([startedAt])
  @@index([status])
  @@map("scanner_executions")
}

model ScannerResultRecord {
  id              String                 @id @default(uuid()) @db.Uuid
  executionId     String                 @db.Uuid
  symbol          String                 @db.VarChar(32)
  strategyId      String?                @db.VarChar(128)
  signalId        String?                @db.Uuid
  accepted        Boolean
  rank            Int?
  score           Decimal?               @db.Decimal(16, 8)
  rejectionCode   String?                @db.VarChar(128)
  rejectionReason String?
  createdAt       DateTime               @default(now()) @db.Timestamptz(6)
  execution       ScannerExecutionRecord @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, accepted, rank])
  @@index([symbol, createdAt])
  @@map("scanner_results")
}

model TaxLotRecord {
  id                String   @id @db.Uuid
  symbol            String   @db.VarChar(32)
  acquisitionFillId String   @db.VarChar(128)
  acquiredAt        DateTime @db.Timestamptz(6)
  acquisitionPrice  Decimal  @db.Decimal(20, 8)
  originalQuantity  Decimal  @db.Decimal(30, 12)
  remainingQuantity Decimal  @db.Decimal(30, 12)
  basisPerShare     Decimal  @db.Decimal(20, 8)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  @@index([symbol, acquiredAt])
  @@index([acquisitionFillId])
  @@map("tax_lots")
}

model LotDispositionRecord {
  id          String   @id @db.Uuid
  saleFillId  String   @db.VarChar(128)
  lotId       String   @db.Uuid
  symbol      String   @db.VarChar(32)
  soldAt      DateTime @db.Timestamptz(6)
  quantity    Decimal  @db.Decimal(30, 12)
  proceeds    Decimal  @db.Decimal(20, 8)
  costBasis   Decimal  @db.Decimal(20, 8)
  realizedPnl Decimal  @db.Decimal(20, 8)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([saleFillId])
  @@index([lotId, soldAt])
  @@map("lot_dispositions")
}

model CostBasisAdjustmentRecord {
  id         String   @id @db.Uuid
  lotId      String   @db.Uuid
  reason     String   @db.VarChar(64)
  amount     Decimal  @db.Decimal(20, 8)
  detail     String
  adjustedAt DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([lotId, adjustedAt])
  @@map("cost_basis_adjustments")
}

model WashSaleRecord {
  id                  String   @id @db.Uuid
  saleFillId          String   @db.VarChar(128)
  replacementLotId    String   @db.Uuid
  symbol              String   @db.VarChar(32)
  replacementQuantity Decimal  @db.Decimal(30, 12)
  disallowedLoss      Decimal  @db.Decimal(20, 8)
  detectedAt          DateTime @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @db.Timestamptz(6)

  @@index([symbol, detectedAt])
  @@index([saleFillId, replacementLotId])
  @@map("wash_sales")
}

model RiskConfigurationRecord {
  id            String    @id @db.VarChar(256)
  version       String    @unique @db.VarChar(128)
  checksum      String    @unique @db.Char(64)
  configuration Json
  active        Boolean   @default(false)
  activatedBy   String?   @db.VarChar(128)
  supersedesId  String?   @db.VarChar(256)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  activatedAt   DateTime? @db.Timestamptz(6)

  @@index([active])
  @@map("risk_configurations")
}

model RiskDecisionRecord {
  id                  String              @id @db.Uuid
  signalId            String              @db.Uuid
  symbol              String              @db.VarChar(32)
  outcome             RiskDecisionOutcome
  reasonCodes         Json
  riskConfigurationId String              @db.VarChar(256)
  decisionSnapshot    Json
  evaluatedAt         DateTime            @db.Timestamptz(6)
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)

  @@index([signalId])
  @@index([symbol, evaluatedAt])
  @@index([outcome, evaluatedAt])
  @@map("risk_decisions")
}

model SafetyStateRecord {
  id              String      @id @default("singleton")
  version         Int         @default(0)
  tradingMode     TradingMode
  mode            SafetyMode
  tradingEnabled  Boolean     @default(false)
